[server]
host = "0.0.0.0"
port = 18083

[kernel]
owner_principal = "human:owner"
state_db = "data/agent-kernel.db"
artifact_root = "data/artifacts"

[model]
diagnosis_model = "gpt-5.6-luna"
execution_model = "gpt-5.6-luna"
gateway_base_url = "http://127.0.0.1:4101/v1"
isolate_worktree = true
disable_docker = true
disable_ssh_credentials = true
worktree_root = "../.control-plane-codex-worktrees"
session_dir = "data/agent-sessions"
max_output_bytes = 200000

[policy]
cooldown_seconds = 600
max_concurrent = 2

[monitoring]
prometheus_url = "http://127.0.0.1:19090"
alertmanager_url = "http://127.0.0.1:19093"
notification_enabled = true

[environment]
# 仅保留个人 Windows 的运维可靠性巡检；不执行 Defender、端口/防火墙、递归目录、云端基线或 CVE 巡检。
enabled = true
cache_seconds = 60
probe_timeout_seconds = 60
docker_build_cache_max_bytes = 5368709120
docker_expected_exited_containers = []
line_ending_auto_discard_repos = []
recovery_paths = []
synchronization_paths = []
# Set this in the ignored local profile when chezmoi is installed.
# chezmoi_source_dir = "<home>/.local/share/chezmoi"
known_garbage_paths = []
garbage_quarantine_dir = "data/recovery-quarantine"
automatic_handling_enabled = true
auto_maintenance_alertnames = ["ControlPlaneGarbageDetected"]
# v2rayn_expected_path = "<path-to-v2rayN>/v2rayN.exe"

[game_mode]
enabled = true
# state_path = "<local-game-mode-state>/state.json"
active_max_age_seconds = 43200
restore_grace_seconds = 600

[projects]
# `allowed_auto` is the standing local auto-repair scope.
# `project_dirs` is the exact path registry used for labels and target resolution; Docker and remote Git stay denied to Codex.
allowed_auto = []
allowed_repo_roots = []

[projects.project_dirs]
# project-name = "<local-repository-path>"
