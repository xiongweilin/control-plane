[server]
host = "0.0.0.0"
port = 18083

[kernel]
owner_principal = "human:owner"
state_db = "data/agent-kernel.db"
artifact_root = "data/artifacts"

[model]
diagnosis_model = "codex/gpt-5.6-luna"
execution_model = "codex/gpt-5.6-luna"
gateway_base_url = "http://127.0.0.1:4101/v1"
isolate_worktree = true
disable_docker = true
disable_ssh_credentials = true
worktree_root = "../.control-plane-codex-worktrees"
session_dir = "data/agent-sessions"
max_output_bytes = 200000

[agent]
gateway_timeout_seconds = 900
max_agent_calls_per_repair = 8

[policy]
cooldown_seconds = 600
max_attempts = 2
per_repair_timeout_seconds = 1800
max_concurrent = 2

[monitoring]
prometheus_url = "http://127.0.0.1:19090"
alertmanager_url = ""
notification_enabled = true
auto_repair_alertnames = ["ContainerRestartStorm", "PrometheusScrapeFailed", "ControlPlaneStaleReady"]

[environment]
# 全部为只读巡检。未配置 cloud_ssh_target 时，云端项目标记为未配置，不会发起 SSH。
enabled = true
cache_seconds = 60
probe_timeout_seconds = 30
cloud_probe_timeout_seconds = 30
windows_scan_roots = ["D:\\agent"]
docker_build_cache_max_bytes = 5368709120
recovery_paths = ["D:\\agent\\ratio", "D:\\agent\\docker备份"]
synchronization_paths = ["D:\\agent\\ratio", "D:\\agent\\control-plane", "D:\\infrastructure\\compose\\dify", "D:\\infrastructure\\compose\\observability", "D:\\infrastructure\\compose\\commerce-orchestrator", "D:\\infrastructure\\compose\\feishu-dify-gateway", "C:\\Users\\metra\\.local\\share\\chezmoi"]
known_garbage_paths = ["D:\\agent\\portable-runtime-worktrees"]
garbage_quarantine_dir = "D:\\agent\\_recovery-quarantine"
automatic_handling_enabled = true
auto_maintenance_alertnames = ["ControlPlaneGarbageDetected"]
v2rayn_expected_path = "D:\\agent\\v2rayN-windows-64\\v2rayN.exe"
cloud_ssh_target = ""
cloud_ssh_identity_file = ""
cloud_protected_root = ""
cloud_tailscale_profile = ""

[game_mode]
enabled = true
state_path = "D:\\agent\\cs2-game-mode\\state.json"
active_max_age_seconds = 43200
restore_grace_seconds = 600

[projects]
# Exact project directories in this list are the standing local auto-repair scope.
# Codex may edit a clean repo in place, but Docker and remote Git stay denied to Codex.
allowed_auto = ["dify", "docker", "observability", "feishu-dify-gateway"]
allowed_repo_roots = ["D:\\infrastructure\\compose", "D:\\agent"]

[projects.project_dirs]
docker = "D:\\infrastructure\\compose\\dify"
dify = "D:\\infrastructure\\compose\\dify"
observability = "D:\\infrastructure\\compose\\observability"
feishu-dify-gateway = "D:\\infrastructure\\compose\\feishu-dify-gateway"
